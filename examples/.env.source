# A package's secret manifest. Drop one `.env.source` in each app/package that
# needs secrets; env-source discovers them all and writes a `.env` next to each.
#
# The grammar is dotenv with STICKY decorators — a comment block sets the
# provider/path/environments for every assignment BELOW it, until the next
# decorator changes them. Blank lines are cosmetic. `# literal` resets to
# provider-less literals.
#
#   # <provider>                     provider id (opens a group)
#   # (env1,env2,...)                environments the provider is consulted in
#   #     /container/path            provider container path
#   #     SOURCE_KEY                 one-shot: source key for the NEXT key only
#   VAR_NAME=<optional default>      emitted variable + optional fallback

# infisical
# (development,preview,production)
#     /payments/stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
#     STRIPE_WEBHOOK_SIGNING_SECRET
WEBHOOK_SECRET=<optional default>

# A new decorator opens a new group.
# infisical
# (development,preview,production)
#     /shared
DATABASE_URL=<optional default>

# A key only sourced in development; elsewhere it falls back to the default.
# infisical
# (development)
#     /shared
DEBUG_TOKEN=off

# Literals (no provider): written verbatim in every environment.
# literal
NODE_ENV=production
PORT=8080
