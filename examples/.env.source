# A package's secret manifest. Drop one `.env.source` in each app/package that
# needs secrets; env-source discovers them all and writes a `.env` next to each.
#
# The grammar is dotenv with decorators — the comment block directly above an
# assignment says where that variable is sourced from:
#
#   # <provider>                       provider id (first decorator line)
#   # (env1,env2,...)                  environments the provider is consulted in
#   #     /container/path              provider container path
#   #     SOURCE_KEY                   optional source key when it differs
#   VAR_NAME=<optional default>        emitted variable + optional fallback

# infisical
# (development,preview,production)
#     /payments/stripe
STRIPE_SECRET_KEY=<optional default>

# infisical
# (development,preview,production)
#     /payments/stripe
#     STRIPE_WEBHOOK_SECRET
WEBHOOK_SECRET=<optional default>

# infisical
# (development,preview,production)
#     /shared
DATABASE_URL=<optional default>

# A key only sourced in development; elsewhere it falls back to the default.
# infisical
# (development)
#     /shared
DEBUG_TOKEN=off

# A literal (no provider decorator): the value is written verbatim in every env.
NODE_ENV=production
